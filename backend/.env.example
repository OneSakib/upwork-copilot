# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, works on Render).
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Shared secret between the extension and this API (set the same value in the extension options)
API_TOKEN=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
